<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickEmoji.App.Popup.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickEmoji.App.Popup">

  <Grid x:Name="RootGrid" CornerRadius="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="ShowTransform" Y="0" />
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search field: SPEC §6.1 — 16px text, no field chrome, focused on show. -->
    <TextBox
        x:Name="SearchBox"
        Grid.Row="0"
        Margin="16,16,16,8"
        FontSize="16"
        BorderThickness="0"
        Background="Transparent"
        PlaceholderText="Search emoji… (English or Български)"
        Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
        PreviewKeyDown="SearchBox_PreviewKeyDown" />

    <!-- Result rows: exactly the top 3, or fewer when fewer clear the minimum score (SPEC §2, §6.1). -->
    <ItemsControl
        x:Name="ResultsList"
        Grid.Row="1"
        ItemsSource="{x:Bind ViewModel.Results}"
        Visibility="{x:Bind ViewModel.ResultsVisibility, Mode=OneWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:ResultRowViewModel">
          <Grid
              Height="52"
              Padding="16,0"
              Background="{x:Bind RowBackground, Mode=OneWay}"
              PointerPressed="ResultRow_PointerPressed"
              Tag="{x:Bind}"
              AutomationProperties.Name="{x:Bind AccessibleName}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                FontFamily="Segoe UI Emoji"
                FontSize="32"
                VerticalAlignment="Center"
                Text="{x:Bind Emoji}"
                AutomationProperties.AccessibilityView="Raw" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="14" Text="{x:Bind Name}" />
              <TextBlock
                  FontSize="11"
                  Opacity="0.65"
                  Text="{x:Bind MatchExplanation}"
                  Visibility="{x:Bind MatchExplanationVisibility}" />
            </StackPanel>

            <Border
                Grid.Column="2"
                Margin="0,0,8,0"
                Padding="8,2"
                CornerRadius="4"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Visibility="{x:Bind BestMatchVisibility}">
              <TextBlock FontSize="11" Foreground="White" Text="Best match" />
            </Border>

            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="&#x21B5;"
                Visibility="{x:Bind SelectedGlyphVisibility, Mode=OneWay}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- SPEC §2: "No results. Try another word." when nothing clears the minimum score. -->
    <TextBlock
        x:Name="NoResultsText"
        Grid.Row="1"
        Margin="16,8"
        Opacity="0.7"
        Text="No match. Try another word."
        Visibility="{x:Bind ViewModel.NoResultsVisibility, Mode=OneWay}" />

    <Border Grid.Row="2" Height="1" Margin="0,4,0,0" Opacity="0.08" Background="{ThemeResource TextFillColorPrimaryBrush}" />

    <!-- Footer key hints (SPEC §6.1). -->
    <TextBlock
        Grid.Row="3"
        Margin="16,8"
        FontSize="11"
        Opacity="0.6"
        Text="↵ insert   ↑↓ select   Ctrl+↵ copy   Esc close" />
  </Grid>
</Window>
