<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(QuickEmojiWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(QuickEmojiMinWindows)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(QuickEmojiMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>QuickEmoji.App</RootNamespace>
    <AssemblyName>QuickEmoji</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Program.Main owns startup so single-instance and logging run before XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="QuickEmojiApplication.xaml" />
    <ApplicationDefinition Include="QuickEmojiApplication.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuickEmoji.Core\QuickEmoji.Core.csproj" />
    <ProjectReference Include="..\QuickEmoji.Platform\QuickEmoji.Platform.csproj" />
  </ItemGroup>
</Project>
